---
import Layout from "@/src/layouts/Layout.astro";
import Header from "@/src/components/Header.astro";
import Footer from "@/src/components/Footer.astro";

const nav = [
  { path: "/", text: "about" },
];

const footer = {
  status: "Say hi",
  email: { label: "Email", url: "mailto:hello@istisiki.me" },
  github: { label: "GitHub", url: "https://github.com/istisiki" },
  linkedin: { label: "LinkedIn", url: "https://www.linkedin.com/in/staceycardoso" },
};
---

<Layout
  title="Stacey Cardoso"
  description="Personal site of Stacey Cardoso."
>
  <Header nav={nav} />

  <main>
    <section class="mt-40 md:mt-48">
      <h1 class="text-2xl mb-6">Stacey Cardoso</h1>

      <p class="mb-6">
        I'm a programmer that loves the challenge of building something from the
        ground up.
      </p>

      <p class="mb-6">
        I currently work for an Australian construction tech start-up called
        <a
          href="https://mastt.com"
          class="underline underline-offset-4 hover:text-primary transition-colors duration-200"
        >Mastt</a>.
      </p>

      <p class="mb-6">
        Outside of work, I busy myself with playing music, training my cats to
        beat dogs at doing tricks, and making tasty coffee. Sometimes I also
        advocate animal welfare through
        <a
          href="https://www.pawpantrymission.org"
          class="underline underline-offset-4 hover:text-primary transition-colors duration-200"
        >Paw Pantry Mission</a>.
      </p>

      <p class="mb-6">
        I live in sunny Cebu, with my partner Cherie, our 3 cats, and our 5
        community dogs.
      </p>
    </section>
  </main>

  <Footer {...footer} />
</Layout>
