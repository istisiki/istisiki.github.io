---
import Layout from "@/src/layouts/Layout.astro";
import Header from "@/src/components/Header.astro";
import Footer from "@/src/components/Footer.astro";

const nav = [
  { path: "/", text: "about" },
  { path: "/experience", text: "experience" },
];

const footer = {
  status: "Available for work",
  email: { label: "Email", url: "mailto:you@istisiki.me" },
  github: { label: "GitHub", url: "https://github.com/istisiki" },
  x: { label: "X", url: "https://x.com/istisiki" },
  linkedin: { label: "LinkedIn", url: "https://linkedin.com/in/istisiki" },
};
---

<Layout
  title="istisiki"
  description="Personal site of istisiki."
>
  <Header nav={nav} />

  <main>
    <section class="mt-40 md:mt-48">
      <h1 class="opacity-50 uppercase mb-6">About</h1>

      <p class="mb-6">
        <!-- TODO: replace with your short bio. Mitchell-style opener, e.g. "I'm a {role} based in {city}. Previously {prior role or company}." -->
        I'm a software engineer. This is placeholder copy — swap it out with a short bio you're happy with.
      </p>

      <p class="mb-6">
        <!-- TODO: current work paragraph — what you're working on now and why it's interesting. -->
        Currently I'm working on <span class="opacity-100">[current project]</span>, a [one-line description].
        Placeholder paragraph — replace with a couple of sentences on what's got your attention today.
      </p>

      <p class="mb-6">
        <!-- TODO: background paragraph — the one-line arc of your career so far. -->
        Before that I spent time at [prior company/companies], working on [themes]. Placeholder paragraph —
        use this to give readers a sense of where you've been without turning it into a resume.
      </p>

      <p class="mb-6">
        <!-- TODO: interests paragraph — the non-work thing you care about. Mitchell uses aviation; pick yours. -->
        Outside of work I'm into [hobby or interest]. Placeholder paragraph — a sentence or two is plenty.
      </p>

      <p class="mb-6 opacity-70 text-[0.87rem]">
        See <a class="underline hover:opacity-100 opacity-100" href="/experience">experience</a> for a fuller work history.
      </p>
    </section>
  </main>

  <Footer {...footer} />
</Layout>
