---
import Layout from "@/src/layouts/Layout.astro";
import Header from "@/src/components/Header.astro";
import Footer from "@/src/components/Footer.astro";

const nav = [
  { path: "/", text: "about" },
  { path: "/experience", text: "experience" },
];

const footer = {
  status: "Available for work",
  email: { label: "Email", url: "mailto:you@istisiki.me" },
  github: { label: "GitHub", url: "https://github.com/istisiki" },
  x: { label: "X", url: "https://x.com/istisiki" },
  linkedin: { label: "LinkedIn", url: "https://linkedin.com/in/istisiki" },
};

// TODO: replace placeholder roles with your actual work history.
const jobs = [
  {
    period: "2024 — now",
    role: "Your Role",
    company: "Current Company",
    description: "One or two lines on what you do here — scope, impact, what you care about.",
  },
  {
    period: "2022 — 2024",
    role: "Previous Role",
    company: "Previous Company",
    description: "Placeholder — describe the work and the bit you're proud of.",
  },
  {
    period: "2020 — 2022",
    role: "Earlier Role",
    company: "Earlier Company",
    description: "Placeholder — short summary, not a bullet list.",
  },
];
---

<Layout
  title="Experience — istisiki"
  description="Work history for istisiki."
>
  <Header nav={nav} />

  <main>
    <section class="mt-40 md:mt-48">
      <h1 class="opacity-50 uppercase mb-6">Experience</h1>

      {
        jobs.map((job) => (
          <ul>
            <li class="mb-4 grid grid-cols-1 md:grid-cols-10">
              <span class="opacity-50 text-[0.87rem] col-span-2">
                {job.period}
              </span>
              <div class="col-span-8">
                <div>
                  <span>{job.role}</span>
                  <span class="opacity-50">|</span>
                  <span>{job.company}</span>
                </div>
                <p class="text-[0.87rem] opacity-50">{job.description}</p>
              </div>
            </li>
          </ul>
        ))
      }
    </section>
  </main>

  <Footer {...footer} />
</Layout>
