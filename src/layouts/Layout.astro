---
import { PageMetadata } from "@/src/components/hybrid-astro-ui/page-metadata";
import OGImage from "@/src/assets/background.png"
import type { ComponentProps } from "astro/types";

type PageMetadataProps = ComponentProps<typeof PageMetadata>;

type Props = {
	title: string;
	description: string;
	shareImage?: PageMetadataProps["image"];
	shareImageAlt?: PageMetadataProps["imageAlt"];
	ogType?: PageMetadataProps["ogType"];
};

const { title, description, shareImage = OGImage, shareImageAlt, ogType = "website" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<PageMetadata
			lang="en"
			title={title}
			description={description}
			image={shareImage}
			imageAlt={shareImageAlt}
			enableClientRouter
			ogType={ogType}
			favicons={[  { rel: "icon", type: "image/png", href: "/icon.png", sizes: "32x32" },]}
		/>
		{/* Production builds only, so local dev visits don't show up in the stats. */}
		{import.meta.env.PROD && (
			<!-- Cloudflare Web Analytics --><script is:inline type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "6e6ebcaed6f9477d8feb771556b852f6"}'></script><!-- End Cloudflare Web Analytics -->
		)}
	</head>
	<body class="*:max-w-2xl *:w-full flex flex-col  items-center w-full font-mono px-5 md:px-0 leading-7" >
		<slot />
	</body>
</html>
